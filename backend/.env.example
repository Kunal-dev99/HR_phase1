# Copy to backend/.env and fill in. Never commit a real .env.
# ENVIRONMENT: development | test | staging | production
ENVIRONMENT=development
# Must point at a database copy (name ending in _copy or _test) for development and tests (D-03).
# pytest always refuses other names; alembic refuses them when ENVIRONMENT is development/test (D-16).
# Default: a local SQLite file, relative to backend/ (no database install needed, D-26).
# For SQLite the file name before .db must end in _copy or _test (D-29).
DATABASE_URL=sqlite+aiosqlite:///./hr_phase1_dev_copy.db
# PostgreSQL alternative (pilot/production use PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://hr_app:YOUR_PASSWORD@localhost:5432/hr_phase1_dev_copy
# AUTH_MODE: disabled (default; every non-public route returns 401) | dev_header (never in production)
AUTH_MODE=disabled
# New screening-run routes are mounted only when true (D-11). Default false.
FEATURE_SCREENING_RUNS=false
# HR_SYSTEM_ADAPTER: unset by default; "mock" is refused when ENVIRONMENT=production.
# HR_SYSTEM_ADAPTER=
# Per-call timeout (seconds) for HR System adapter calls; one attempt, no retries (D-06).
# HR_SYSTEM_TIMEOUT_SECONDS=10
# HR System statuses eligible for screening (D-07), as JSON. Default ["open"].
# REQUISITION_ELIGIBLE_SOURCE_STATUSES=["open"]
